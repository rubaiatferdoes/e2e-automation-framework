# Copy to .env and fill in. NEVER commit .env. Mirror environment values only.

# Safety guard — the production domain. Tests refuse to run if any URL below contains it.
PROD_DOMAIN=

# Mirror environment
MIRROR_BASE_URL=
MIRROR_API_URL=
MIRROR_SWAGGER_URL=

# Test tenants (dummy accounts on the mirror)
QA_TENANT_A_USER=
QA_TENANT_A_PASSWORD=
QA_TENANT_B_USER=
QA_TENANT_B_PASSWORD=

# Product decisions (fill once answered — see CLAUDE.md scope table)
KEY_REVOCATION_MAX_SECONDS=
CROSS_TENANT_STATUS=

# Database (leave empty until the DB type is decided) — read-only user
DB_TYPE=
DB_URL=
DB_READONLY_USER=
DB_READONLY_PASSWORD=
