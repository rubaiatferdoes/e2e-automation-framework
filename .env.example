# Copy to .env and fill in. NEVER commit .env. Test environment values only.

# ===== REQUIRED — the readiness check fails if any of these is empty =====

# Test environment
TEST_ENV_BASE_URL=
TEST_ENV_API_URL=
TEST_ENV_SWAGGER_URL=

# Test tenants (dummy accounts on the test environment)
QA_TENANT_A_USER=
QA_TENANT_A_PASSWORD=
QA_TENANT_B_USER=
QA_TENANT_B_PASSWORD=

# ===== DISCOVERY — how the agents are allowed to travel the app =====

# Hosts discovery may navigate to, comma separated. A link to anywhere
# else ends the walk. Leave empty to allow only the host of
# TEST_ENV_BASE_URL — which is the safe default.
DISCOVERY_ALLOWED_HOSTS=

# Watch the walk happen (slower, useful the first time): true | false
DISCOVERY_HEADED=false

# Safety cap for the count/quota probe: it creates records one at a time
# until rejected, and stops here no matter what. Empty = 25.
DISCOVERY_QUOTA_PROBE_CAP=25

# ===== OPTIONAL — leave empty until decided; dependent checks are SKIPPED, not failed =====

# Product decisions (see CLAUDE.md scope table)
KEY_REVOCATION_MAX_SECONDS=
CROSS_TENANT_STATUS=

# Database — read-only user (see docs/requirements/db/README.md)
# SELECT rights alone are enough: the schema is read from information_schema,
# and each event's tables/columns are found by tracing the qa- record.
# Until DB_TYPE is set, event DB mappings stay PENDING and DB checks skip.
DB_TYPE=
DB_URL=
DB_READONLY_USER=
DB_READONLY_PASSWORD=

# Which schema the application's tables live in. Empty = the driver default
# (postgres: public, mysql: the database in DB_URL, mssql: dbo).
DB_SCHEMA=
