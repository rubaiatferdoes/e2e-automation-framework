# Copy to .env and fill in. NEVER commit .env. Mirror environment values only.

# ===== REQUIRED — the readiness check fails if any of these is empty =====

# Safety guard — exact production hostnames, comma-separated (no https://, no paths).
# Tests refuse to run if any mirror URL's hostname equals one of these.
# Example: PROD_HOSTS=app.company.com,api.company.com
PROD_HOSTS=

# Mirror environment
MIRROR_BASE_URL=
MIRROR_API_URL=
MIRROR_SWAGGER_URL=

# Test tenants (dummy accounts on the mirror)
QA_TENANT_A_USER=
QA_TENANT_A_PASSWORD=
QA_TENANT_B_USER=
QA_TENANT_B_PASSWORD=

# ===== OPTIONAL — leave empty until decided; dependent checks are SKIPPED, not failed =====

# Product decisions (see CLAUDE.md scope table)
KEY_REVOCATION_MAX_SECONDS=
CROSS_TENANT_STATUS=

# Database — read-only user (see docs/input/db/README.md)
DB_TYPE=
DB_URL=
DB_READONLY_USER=
DB_READONLY_PASSWORD=
